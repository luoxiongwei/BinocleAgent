data/pair_aliases.json

# Jupyter 检查点（vendor 复制带入的垃圾）
.ipynb_checkpoints/

# results/ 全部为运行产物，不随仓库分发（首次运行自动生成；RAG 库用 scripts/rag_index.py 重建）
results/*

# COCO 预训练权重（仅将来重训练用，纯推理不需要，见 libs/README.md）
libs/ultralytics/py/*.pt

# 清理暂存区（见 trash/README.md；确认无用后可整体删除）
trash/

